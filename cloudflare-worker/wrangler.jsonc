{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "genogram-ai-helper",
  "main": "src/index.js",
  "compatibility_date": "2026-07-28",
  "ai": { "binding": "AI" },
  "ratelimits": [
    {
      "name": "AI_RATE_LIMITER",
      "namespace_id": "61101",
      "simple": { "limit": 6, "period": 60 }
    }
  ],
  "vars": {
    "ALLOWED_ORIGINS": "https://genesis-caotun.github.io,null",
    "SERVICE_NAME": "騰元家系圖 AI 協助服務"
  }
}
